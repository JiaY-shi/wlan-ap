+    ret_t   (*fPhydrv_Ptp1PPSOutput_get)(rtk_uint32 *, rtk_enable_t *);
+    ret_t   (*fPhydrv_Ptp1PPSOutput_set)( rtk_uint32, rtk_enable_t);
