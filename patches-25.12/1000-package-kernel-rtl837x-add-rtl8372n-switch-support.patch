+static rtk_uint32 _bit_op(rtk_uint32 *pSmiHsbData, rtk_uint32 highBit, rtk_uint32 lowBit)
+{
+    rtk_uint32 data = 0;
+    rtk_uint32 bit;
+    rtk_uint32 i;
+    rtk_uint32 cnt = 0;
+
+    for (i = lowBit; i <= highBit; i++)
+    {
+        bit = ((*(pSmiHsbData + (i/32)) & (0x0001 << (i % 32))) != 0) ? 1 : 0;
+        data |= (bit <<(cnt));
+
+        cnt++;
+    }
+
+    return data;
+}
