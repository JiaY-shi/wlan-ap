+    if((retVal = rtl8373_getAsicRegBit(RTL8373_VLAN_CTRL_ADDR, RTL8373_VLAN_CTRL_VID4095_TYPE_OFFSET, (rtk_uint32 *)pActVid4095)) != RT_ERR_OK)
