+    dal_rtl8373_ptp_ClkSrcCtrl_set(0);// 1-external,0=internal                                                          
+    dal_rtl8373_ptp_tpid_set( INNER_VLAN, 0, 0X8100);
+    dal_rtl8373_ptp_tpid_set( OUTER_VLAN, 0, 0X88a8);
+
+    dal_rtl8373_ptp_RefTimeFreqCfg_set(freq,ENABLED);
+    
+    return RT_ERR_OK;
+}
