+rtk_api_ret_t dal_rtl8373_svlanTrapPri_get(rtk_pri_t *pPriority)
+{
+    rtk_api_ret_t   retVal = 0;
+
+    RTK_CHK_INIT_STATE();
+
+    if(NULL == pPriority)
