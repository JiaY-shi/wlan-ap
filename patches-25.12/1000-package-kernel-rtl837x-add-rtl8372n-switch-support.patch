+    RTK_API_UNLOCK();
+
+    return retVal;
+}
+
+/* Function Name:
+ *      rtk_led_groupConfig_set
+ * Description:
+ *      Set per group Led to congiuration mode
+ * Input:
+ *      setid       -  4 groups led setting 0 ~ 3
+ *      ledid       -  4 leds, 0 ~ 3
+ *      pConfig  .
+ *                      led_2p5g;
+ *                      led_two_pair_1g;
+ *                      led_1g;
+ *                      led_500m;
+ *                      led_100m;
+ *                      led_10m;
+ *                      led_link;
+ *                      led_link_flash;
+ *                      led_act;
+ *                      led_rx;
+ *                      led_tx;
+ *                      led_col;
