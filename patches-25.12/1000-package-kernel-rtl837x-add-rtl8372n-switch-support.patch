+
+    keepMode = (mode == MIRROR_FOLLOW_VLAN) ? 0 : 1;
+    if ((retVal = rtl8373_setAsicRegBit(RTL8373_MIR_CTRL_ADDR, RTL8373_MIR_CTRL_MIR_REALKEEP_EN_OFFSET, keepMode)) != RT_ERR_OK)
