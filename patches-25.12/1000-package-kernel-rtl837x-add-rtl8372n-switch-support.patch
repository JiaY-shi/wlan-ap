+rtk_api_ret_t dal_rtl8373_gpio_muxSel_get(rtk_uint32 gpioNum, rtk_enable_t *pStatus )
+{
+    rtk_api_ret_t retVal = 0;
+    rtk_uint32 val = 0, mask  = 0;
+
+    if(gpioNum > GPIO_MAX_PIN_NUM) 
+        return RT_ERR_RANGE;
