+
+ret_t dal_rtl8373_asicRmaTrapPri_set(rtk_uint32 pri)
+{
+	ret_t retVal;
+	retVal = rtl8373_setAsicRegBits(RTL8373_RMA_CFG_ADDR, RTL8373_RMA_CFG_RMA_TRAP_PRI_MASK, pri);
