+    if((ret = rtl8373_getAsicReg(RTL8373_PTP_TIME_NSEC_RD1_ADDR, &nsec_h)) != RT_ERR_OK)
+        return ret;
+    if((ret = rtl8373_getAsicReg(RTL8373_PTP_TIME_NSEC_RD0_ADDR, &nsec_l)) != RT_ERR_OK)
+        return ret;
