+ *      RT_ERR_NULL_POINTER - input parameter may be null pointer
+ * Note:
+ *      None
+ */
+ret_t dal_rtl8373_ptp_ClockOutput_get(  rtk_time_clkOutput_t *pClkOutput)
+{
+        ret_t   ret = RT_ERR_OK;
+        rtk_uint32  reg_val = 0;
+        rtk_uint32  sec_l = 0;
+        rtk_uint32  sec_m = 0;
+        rtk_uint32  sec_h = 0;
