+    rtl8373_getAsicRegBit(RTL8373_TOD_INTR_ADDR, RTL8373_TOD_INTR_IMR_TOD_OFFSET, &tod_done);
+    rtl8373_getAsicRegBit(RTL8373_PTP_MIB_INTR_ADDR, RTL8373_PTP_MIB_INTR_CFG_IMR_PTP_OFFSET, &txtime_empty);
