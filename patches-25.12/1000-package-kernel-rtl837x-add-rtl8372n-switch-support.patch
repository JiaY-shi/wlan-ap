+        serdes_patch(CHIP_MODE, SDS_INDX, SDS_MODE);
+        delay_loop(1000);
+        dal_rtl8224_sds_regbits_write(SDS_INDX, 0x20, 0x00, 0x3 << 4, 0x3);
