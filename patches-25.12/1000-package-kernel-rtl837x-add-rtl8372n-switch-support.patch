+        if(retVal != RT_ERR_OK)
+            return retVal;
+
+        *tableAddr = regData;
+        tableAddr++;
+    }
+
+//read the second 5 32bits
+
+    regData = 1 | (0 << RTL8373_ITA_CTRL0_TLB_ACT_OFFSET) | (7 << RTL8373_ITA_CTRL0_TLB_TYPE_OFFSET) | (1 << RTL8373_ITA_CTRL0_TBL_ADDR_OFFSET);
+    retVal = rtl8373_setAsicReg(RTL8373_ITA_CTRL0_ADDR, regData);
