+ *      The mirror keep mode is as following:
+ *      - MIRROR_FOLLOW_VLAN
+ *      - MIRROR_KEEP_ORIGINAL
+ *      - MIRROR_KEEP_END
+ */
+rtk_api_ret_t dal_rtl8373_mirror_keep_set(rtk_mirror_keep_t mode)
+{
+    rtk_api_ret_t retVal = 0;
