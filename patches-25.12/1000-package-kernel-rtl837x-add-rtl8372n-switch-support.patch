+    if(sdsid == SERDES_ID0)
+    {
+        retVal =rtl8373_setAsicRegBits(RTL8373_SMI_MAC_TYPE_CTRL_ADDR, RTL8373_SMI_MAC_TYPE_CTRL_MAC_PORT3_TYPE_MASK, 1);
+        if(retVal != RT_ERR_OK)
