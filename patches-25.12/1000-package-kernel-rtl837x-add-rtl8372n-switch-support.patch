+static ret_t _rtl8373_portlink_get(rtk_uint32 port, rtk_uint32* link)
+{
+    rtk_uint32 regData = 0;
+    ret_t retVal;
+
+    retVal = rtl8373_getAsicReg(RTL8373_MAC_LINK_STS_ADDR, &regData);
+    if(retVal != RT_ERR_OK)
+        return retVal;
+
+    retVal = rtl8373_getAsicReg(RTL8373_MAC_LINK_STS_ADDR, &regData);
+    if(retVal != RT_ERR_OK)
+        return retVal;
+
+    *link = (regData >> port) & 1;
+    
+    return RT_ERR_OK;
+}
