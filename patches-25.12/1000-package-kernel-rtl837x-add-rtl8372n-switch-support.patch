+    
+    return retVal;
+}   /* end of rtk_svlan_trapPri_get */
+
+/* Function Name:
+ *      dal_rtl8373_svlanTrapCpumsk_set
+ * Description:
+ *      Set svlan trap cpu mask
+ * Input:
+ *      mask - cpu mask; bit0: internal cpu; bit1: external cpu
