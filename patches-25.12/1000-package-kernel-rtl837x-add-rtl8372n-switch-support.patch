+static rtk_api_ret_t _rtl8373_setAclAct(rtk_uint32 index, rtl8373_acl_act_t* pAclAct)
+{
+    rtk_uint32 aclActSmi[RTL8373_ACL_ACT_ENTRY_LEN];
+    rtk_uint32 regAddr, regData;
