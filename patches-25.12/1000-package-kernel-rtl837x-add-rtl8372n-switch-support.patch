+
+        dal_rtl8224_sds_regbits_write(SDS_INDX, 0x20, 0x00, 0x3 << 6, 0x3);
+        delay_loop(100);
+
+        dal_rtl8224_sds_regbits_write(SDS_INDX, 0x20, 0x00, 0x3 << 10, 0x3);
+        delay_loop(10);
+
+        dal_rtl8224_sds_regbits_write(SDS_INDX, 0x20, 0x00, 0x3 << 10, 0x1);
+        delay_loop(10);
+
+        dal_rtl8224_sds_regbits_write(SDS_INDX, 0x20, 0x00, 0x3 << 10, 0x1);
+        delay_loop(10);
+
+        dal_rtl8224_sds_regbits_write(SDS_INDX, 0x20, 0x00, 0x3 << 10, 0x3);
+        delay_loop(100);
