+static int rtl837x_sw_set_port_pvid(struct switch_dev *dev, int port, int val)
+{
+	struct rtk_gsw *gsw = container_of(dev, struct rtk_gsw, sw_dev);
+
+	if (port > gsw->num_ports) return -22;
+
+	gsw->port_pvid[port] = val;
+
+	return 0;
+}
