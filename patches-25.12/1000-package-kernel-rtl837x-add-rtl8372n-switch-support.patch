+            if((retVal = rtl8373_setAsicRegBits(RTL8373_LED3_0_SET1_0_CTRL1_ADDR, RTL8373_LED3_0_SET1_0_CTRL1_SET1_LED3_SEL1_MASK, sel1))!= RT_ERR_OK)
+                return retVal;
