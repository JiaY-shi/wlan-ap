+
+    if ((retVal = rtl8373_getAsicRegBits(RTL8373_DOT1X_UNAUTH_ACT_ADDR(port), RTL8373_DOT1X_UNAUTH_ACT_PORT_ACT_MASK(port), pUnauth_action)) != RT_ERR_OK)
+        return retVal;
+
+    return RT_ERR_OK;
