+ */
+
+ret_t dal_rtl8373_asicRmaTrapPri_get(rtk_uint32 * pri)
+{
+	ret_t retVal;
+	retVal = rtl8373_getAsicRegBits(RTL8373_RMA_CFG_ADDR, RTL8373_RMA_CFG_RMA_TRAP_PRI_MASK, pri);
+
+	return retVal;
+}
+
