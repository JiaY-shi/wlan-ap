+rtk_api_ret_t SDS_MODE_SET_SW(rtk_uint32 CHIP_MODE, rtk_uint32 SDS_INDX, rtk_uint32 SDS_MODE)
+{
+
+    if ((CHIP_MODE != CHIP_RTL8224_MODE) && (CHIP_MODE != CHIP_RTL8224N_MODE))
